TELEGRAM_BOT_TOKEN=COLLE_ICI_LE_TOKEN_BOTFATHER
ALLOWED_TELEGRAM_USER_IDS=123456789

# Image Docker préconfigurée
DEFAULT_IMAGE=docker.io/abess237/abess-ops1:latest
DEFAULT_REGION=europe-west1
SERVICE_NAME_PREFIX=abess-run

# false = service privé ; true = URL accessible publiquement sans connexion Google
# N'active true que si l'image est conçue pour être exposée publiquement.
ALLOW_UNAUTHENTICATED=false

GCLOUD_BIN=gcloud
DEPLOY_TIMEOUT_SECONDS=900
